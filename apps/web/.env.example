PORT=3000
API_BASE_URL=http://localhost:3001/api/v1
PUBLIC_APP_URL=http://localhost:3000
# Optional direct provider override. Empty uses the same-origin `/api/map` proxy.
NEXT_PUBLIC_MAP_STYLE_URL=
# Use deterministic local fixtures only when intentionally developing offline.
# Keep false when the backend is running; mock and live data are never mixed.
USE_MOCK_DATA=false
# Enable lead consent only after legal approval. Both values are required.
NEXT_PUBLIC_LEAD_CONSENT_URL=
NEXT_PUBLIC_LEAD_CONSENT_VERSION=
